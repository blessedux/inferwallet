# Infer Proxy
INFER_PROXY_PORT=8787
COMPANION_ORIGIN=http://localhost:5173
# Set to 1 for local demos without Horizon verification
SKIP_CHAIN_VERIFY=1
SETTLEMENT_TIMEOUT_MS=120000

# Treasury Absorb — operator OpenRouter key (server-only, never in Companion)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TIER_MODEL_CHEAP=openai/gpt-4o-mini
TIER_MODEL_BALANCED=anthropic/claude-3.5-sonnet
TIER_MODEL_PREMIUM=anthropic/claude-3.5-sonnet

# Spend guards (see docs/operator-spend-guards.md)
DAILY_USD_CEILING=50
KILL_SWITCH=0
# KILL_SWITCH_FILE=./.kill-switch

