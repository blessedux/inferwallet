{
  "name": "inferwallet",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter @inferwallet/sdk --filter @inferwallet/infer-proxy test",
    "build": "bun run --filter '*' build",
    "dev:proxy": "bun run --filter @inferwallet/infer-proxy dev",
    "dev:companion": "bun run --filter @inferwallet/companion dev",
    "issue:szx": "bun run scripts/issue-szx-testnet.ts",
    "fix:sink-trustline": "bun run scripts/fix-sink-trustline.ts",
    "fund:szx": "bun run scripts/fund-freighter-szx.ts",
    "seed:sdex": "bun run scripts/seed-sdex-book.ts"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "typescript": "^5.8.2"
  }
}
